[Desktop Entry]
Name=GhostKVM
Comment=Share this computer's keyboard and mouse with a Chromebook over Bluetooth
Exec=$HOME/.local/bin/ghostkvm
Icon=ghostkvm
Terminal=false
Type=Application
Categories=Utility;
Keywords=kvm;keyboard;mouse;bluetooth;chromebook;share;
StartupNotify=false
StartupWMClass=io.ghostkvm.app
