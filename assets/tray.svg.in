      <ellipse cx="14.8" cy="10.6" rx="1.7" ry="2.2" fill="black"/>
    </mask>
  </defs>
  <path mask="url(#eyes)" fill="@COLOR@" d="M4 10.5 A8 8 0 0 1 20 10.5 V20.6 Q18.67 22.7 17.33 20.6 Q16 18.5 14.67 20.6 Q13.33 22.7 12 20.6 Q10.67 18.5 9.33 20.6 Q8 22.7 6.67 20.6 Q5.33 18.5 4 20.6 Z"/>
